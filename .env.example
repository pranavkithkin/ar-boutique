# TASK-005: copy to .env.local and fill in values. Never commit .env.local.
# These six variables are required for the current catalogue/media milestone.
# Leave credentials blank here; there are no real credentials in this file.

# Browser-safe. Use the Supabase project API URL, not a database connection URL.
# HTTPS is required for production builds. Loopback HTTP is allowed in dev/test.
NEXT_PUBLIC_SUPABASE_URL=
# Modern sb_publishable_... key only. Never use sb_secret_... or service-role JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never prefix any Cloudinary variable with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Allowed: ar-dev | ar-staging | ar-prod.
# Current test deployment on Vercel Production still uses ar-staging.
CLOUDINARY_FOLDER=ar-staging

# Next.js supplies NODE_ENV; do not set it here.
# Future Stripe, Clerk, Resend, Sentry and service-role credentials are not
# required or consumed yet. Add validation when those services are implemented.
# No validation bypass is provided. Missing/invalid required values fail startup.
