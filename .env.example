# -----------------------------------------------------------------------------
# AR BOUTIQUE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit .env.local.
# -----------------------------------------------------------------------------

# Supabase (Database, Auth & RPC)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudinary (Product Media - ADR-038)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ar-dev # Options: ar-dev | ar-staging | ar-prod

# Clerk (Customer Authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Resend (Transactional Emails - ADR-009)
RESEND_API_KEY=

# Stripe (Card Payments & Webhooks)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (Error Monitoring & Performance)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Internal Cron / Job Security
CRON_SECRET=
